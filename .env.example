# NoticeSense AI Environment Configuration

# Server Port (default 3000)
PORT=3000

# Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Supabase PostgreSQL Database (Optional - App uses local JSON storage if omitted)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Client CORS origin (for local development or production domain)
ALLOWED_ORIGIN=*
