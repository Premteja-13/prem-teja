      "destination": "/api/index.js"
    },
    {
      "source": "/analyze",
      "destination": "/api/index.js"
    },
    {
      "source": "/notices",
      "destination": "/api/index.js"
    },
    {
      "source": "/upcoming",
      "destination": "/api/index.js"
    }
  ]
}
